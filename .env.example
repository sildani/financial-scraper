GEMINI_API_KEY=your_gemini_api_key_here

# Plaid API Credentials
# Get from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
# PLAID_ENV is 'sandbox' or 'production'; anything else stops the run.
# It also picks the token store (.plaid_tokens.<PLAID_ENV>.json).
# PLAID_SECRET and SPREADSHEET_ID must belong to the same Environment:
#   sandbox    -> Sandbox secret, a Google Sheet used only for testing
#   production -> Production secret, your real Google Sheet
PLAID_ENV=sandbox
PLAID_SECRET=
SPREADSHEET_ID=your_google_spreadsheet_id_here
