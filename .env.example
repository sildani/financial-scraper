GEMINI_API_KEY=your_gemini_api_key_here

# Plaid API Credentials
# Get from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
# PLAID_ENV is required: 'sandbox' or 'production'. Unset or anything else stops the run.
# It picks the token store (.plaid_tokens.<PLAID_ENV>.json) and the Google Sheet below.
PLAID_ENV=sandbox
# The secret must belong to the same Environment as PLAID_ENV
PLAID_SECRET=

# Google Sheets, one per Environment. Only the one PLAID_ENV selects is required.
SPREADSHEET_ID_SANDBOX=your_test_google_spreadsheet_id_here
SPREADSHEET_ID_PRODUCTION=your_real_google_spreadsheet_id_here
